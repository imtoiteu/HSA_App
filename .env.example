# ---- HSA-app production configuration (copy to .env; never commit .env) ----
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# public URL students use (reset links, webhook URLs shown in admin)
HSA_PUBLIC_BASE_URL=http://YOUR-SERVER:8620
# set to true only when served over HTTPS (behind a TLS reverse proxy)
HSA_COOKIE_SECURE=false
HSA_SECRET_KEY=change-me-to-a-long-random-value
HSA_LOG_LEVEL=INFO
HSA_WORKERS=2

# database (internal to the compose network; not published)
POSTGRES_DB=hsa
POSTGRES_USER=hsa
POSTGRES_PASSWORD=change-me

# web port published on the host (other ports stay internal)
WEB_BIND=0.0.0.0
WEB_PORT=8620
# Dockerfile (self-contained) or Dockerfile.prebuilt (build the SPA on the host; slow networks)
WEB_DOCKERFILE=Dockerfile

# read-only upstream question bank mounted into the api container
UPSTREAM_PATH=/root/imtoiteu/HSA-question-bank

# backups (pg_dump custom format) — host directory and retention
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# payment webhook secrets (leave empty to keep a provider disabled)
HSA_SEPAY_API_KEY=
HSA_CASSO_SECURE_TOKEN=
HSA_GENERIC_WEBHOOK_SECRET=

# optional SMTP for password-reset e-mails (without it admins issue reset links)
HSA_SMTP_HOST=
HSA_SMTP_PORT=587
HSA_SMTP_USER=
HSA_SMTP_PASSWORD=
HSA_SMTP_FROM=
